<UserControl x:Class="HotelViewer.Presentation.Controls.EntityTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HotelViewer.Presentation.Controls"
             xmlns:converters="clr-namespace:HotelViewer.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.Resources>
    <converters:RoleToVisibilityConverter x:Key="RoleToVis"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,5"/>
      <Setter Property="Margin" Value="5,0"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Style="{StaticResource TableToolbox}">
      <Button Content="Обновить"
              Command="{Binding LoadCommand}" />
      <Button Content="Добавить"
              Command="{Binding AddCommand}"
              Visibility="{Binding Session.CurrentUser.Value.Role,
              Converter={StaticResource RoleToVis},
              ConverterParameter=Redactor}" />
      <Button Content="Удалить"
              Command="{Binding DeleteSelectedCommand}"
              Visibility="{Binding Session.CurrentUser.Value.Role,
              Converter={StaticResource RoleToVis},
              ConverterParameter=Redactor}" />
    </StackPanel>
    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="True"
              IsReadOnly="True"
              Margin="5" />
  </Grid>
</UserControl>

