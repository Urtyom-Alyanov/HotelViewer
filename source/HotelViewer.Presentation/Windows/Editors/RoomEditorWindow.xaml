<Window x:Class="HotelViewer.Presentation.Windows.Editors.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        mc:Ignorable="d"
        Title="RoomEditorWindow" Height="240" Width="500">
  <StackPanel Margin="20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Номер комнаты:"/>
        <TextBox x:Name="TxtRoomNumber" Margin="0,5"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Идентификатор гостиницы:"/>
        <TextBox x:Name="TxtHotelId" Margin="0,5"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="Тип комнаты:"/>
    <ComboBox ItemsSource="{Binding AllTypes}"
              SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}"
              Margin="0,5,0,15">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource EnumConv}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,20" Height="30"/>
  </StackPanel>
</Window>

