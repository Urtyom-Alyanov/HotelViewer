<Window x:Class="HotelViewer.Presentation.Windows.Editors.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        xmlns:viewModels="clr-namespace:HotelViewer.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="RoomEditorWindow" Height="280" Width="500">
  <StackPanel Margin="20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Гостиница:"/>
        <ComboBox x:Name="CmbHotel"
                  ItemsSource="{Binding Source={x:Static viewModels:MainViewModel.Instance}, Path=Hotels.Items}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  Style="{StaticResource ComboBox}"
                  Margin="2,5"/>
      </StackPanel>
      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" >
          <TextBlock Text="Этаж:" Margin="0 0 10 0"/>
          <TextBox x:Name="TxtRoomStage" Style="{StaticResource TextBox}" Margin="2,5"/>
        </StackPanel>
        <StackPanel Grid.Column="1" >
          <TextBlock Text="Номер комнаты:"/>
          <TextBox x:Name="TxtRoomNumber" Style="{StaticResource TextBox}" Margin="2,5"/>
        </StackPanel>
      </Grid>
    </Grid>

    <TextBlock Text="Тип комнаты:"/>
    <ComboBox ItemsSource="{Binding AllTypes}"
              SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}"
              Margin="0,5,0,15"
              Style="{StaticResource ComboBox}"
              >
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource EnumConv}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <Button Content="Сохранить" Style="{StaticResource SuccessButton}" Click="BtnSave_Click" Margin="0,10, 0, 0"/>
  </StackPanel>
</Window>

