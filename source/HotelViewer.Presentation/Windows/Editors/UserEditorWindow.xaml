<Window x:Class="HotelViewer.Presentation.Windows.Editors.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        xmlns:converters="clr-namespace:HotelViewer.Presentation.Converters"
        mc:Ignorable="d"
        Title="Изменение пользователя" Height="300" Width="500">
  <Window.Resources>
    <converters:EnumDescriptionConverter x:Key="EnumConv"/>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock Text="Имя пользователя:"/>
    <TextBox Style="{StaticResource TextBox}" x:Name="TxtUsername" Margin="0,5"/>

    <TextBlock Text="Роль пользователя:"/>
    <ComboBox ItemsSource="{Binding AllRoles}"
              Style="{StaticResource ComboBox}"
              SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
              Margin="0,5,0,10">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource EnumConv}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Text="Новый пароль:"/>
    <TextBox Style="{StaticResource TextBox}" x:Name="TxtNewPassword" Margin="0,5"/>

    <Button Content="Сохранить" Style="{StaticResource SuccessButton}" Click="BtnSave_Click" Margin="0,10, 0, 0"/>
  </StackPanel>
</Window>

