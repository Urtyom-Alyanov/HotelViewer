<Window x:Class="HotelViewer.Presentation.Windows.Editors.ResidenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        mc:Ignorable="d"
        Title="Изменение записи о проживании" Height="500" Width="500">
  <StackPanel Margin="20">
    <TextBlock Text="ID (число):"/>
    <TextBox x:Name="TxtId" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="Номер:"/>
    <TextBox x:Name="TxtRoomNumber" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="Идентификатор отеля:"/>
    <TextBox x:Name="TxtHotelId" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="Идентификатор проживающего:"/>
    <TextBox x:Name="TxtResidentId" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="На сколько дней:"/>
    <TextBox x:Name="TxtDaysPerNight" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="Дата и время прибытия:"/>
    <TextBox x:Name="TxtDateTime" Style="{StaticResource TextBox}" Margin="0,5"/>

    <Button Content="Сохранить" Style="{StaticResource SuccessButton}" Click="BtnSave_Click" Margin="0,10, 0, 0"/>
  </StackPanel>
</Window>

