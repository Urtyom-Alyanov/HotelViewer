<Window x:Class="HotelViewer.Presentation.Windows.Editors.ResidentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        mc:Ignorable="d"
        Title="Изменение проживающего" Height="370" Width="500">
  <StackPanel Margin="20">
    <TextBlock Text="ID (число):"/>
    <TextBox x:Name="TxtId" Margin="0,5"/>

    <TextBlock Text="ФИО:"/>
    <TextBox x:Name="TxtName" Margin="0,5"/>

    <TextBlock Text="Адрес:"/>
    <TextBox x:Name="TxtAddress" Margin="0,5"/>

    <TextBlock Text="Телефон:"/>
    <TextBox x:Name="TxtPhone" Margin="0,5"/>

    <TextBlock Text="Пол:"/>
    <ComboBox ItemsSource="{Binding AllSexes}"
              SelectedItem="{Binding SelectedSex, Mode=TwoWay}"
              Margin="0,5,0,15">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource EnumConv}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,20" Height="30"/>
  </StackPanel>
</Window>

