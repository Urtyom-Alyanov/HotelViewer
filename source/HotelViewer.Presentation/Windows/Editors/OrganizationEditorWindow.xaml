<Window x:Class="HotelViewer.Presentation.Windows.Editors.OrganizationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows.Editors"
        mc:Ignorable="d"
        Title="Изменение организации" Height="260" Width="500">
  <StackPanel Margin="20">
    <TextBlock Text="ID (число):"/>
    <TextBox x:Name="TxtId" Style="{StaticResource TextBox}" Margin="0,5"/>

    <TextBlock Text="Название:"/>
    <TextBox x:Name="TxtName" Style="{StaticResource TextBox}" Margin="0,5"/>

    <Button Content="Сохранить" Style="{StaticResource SuccessButton}" Click="BtnSave_Click" Margin="0,10, 0, 0"/>
  </StackPanel>
</Window>

