<Window x:Class="HotelViewer.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelViewer.Presentation.Windows"
        xmlns:controls="clr-namespace:HotelViewer.Presentation.Controls"
        xmlns:converters="clr-namespace:HotelViewer.Presentation.Converters"
        mc:Ignorable="d"
        Title="Управление гостиницами" Height="450" Width="800">
  <Window.Resources>
    <converters:RoleToVisibilityConverter x:Key="RoleToVis"/>

    <Style x:Key="TableToolbox" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,5"/>
      <Setter Property="Margin" Value="5,0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Background="#EEE" Padding="10">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Text="Вы вошли как: " FontWeight="Bold"/>
          <TextBlock Text="{Binding CurrentUser.Username.Value}" Margin="5,0,20,0"/>
          <TextBlock Text="Роль: " FontWeight="Bold"/>
          <TextBlock Text="{Binding CurrentUser.Role, Converter={StaticResource EnumConv}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button
            Command="{Binding LogoutCommand}"
            Background="#D23333"
            Foreground="White"
            Content="Выйти"
            >
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
              </Style>
            </Button.Resources>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="5">
      <TabItem Header="Организации">
        <controls:EntityTableControl DataContext="{Binding Organizations}"/>
      </TabItem>

      <TabItem Header="Гостиницы">
        <controls:EntityTableControl DataContext="{Binding Hotels}"/>
      </TabItem>

      <TabItem Header="Номера">
        <controls:EntityTableControl DataContext="{Binding Rooms}"/>
      </TabItem>

      <TabItem Header="Проживающие">
        <controls:EntityTableControl DataContext="{Binding Residents}"/>
      </TabItem>

      <TabItem Header="Журнал проживания">
        <controls:EntityTableControl DataContext="{Binding Residencies}"/>
      </TabItem>

      <TabItem Header="Пользователи"
               Visibility="{Binding CurrentUser.Role,
                 Converter={StaticResource RoleToVis},
                 ConverterParameter=Admin}">
        <controls:EntityTableControl DataContext="{Binding Users}"/>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
