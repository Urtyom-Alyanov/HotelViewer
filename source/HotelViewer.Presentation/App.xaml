<Application x:Class="HotelViewer.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HotelViewer.Presentation"
             xmlns:converters="clr-namespace:HotelViewer.Presentation.Converters">
    <Application.Resources>
      <converters:DomainObjectConverter x:Key="DomainConv"/>
      <converters:RoleToVisibilityConverter x:Key="RoleToVis"/>
      <converters:EnumDescriptionConverter x:Key="EnumConv"/>

      <converters:ConverterGroup x:Key="DomainThenUpper">
        <StaticResource ResourceKey="DomainConv"/>
        <StaticResource ResourceKey="RoleToVis"/>
        <StaticResource ResourceKey="EnumConv"/>
      </converters:ConverterGroup>

      <Style x:Key="TableToolbox" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Margin" Value="5,0"/>
      </Style>
    </Application.Resources>
</Application>
