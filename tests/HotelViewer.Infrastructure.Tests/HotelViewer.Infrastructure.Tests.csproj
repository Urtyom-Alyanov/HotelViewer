        <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-77" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit.v3" Version="4.0.0-pre.128" />
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0-pre.128" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\source\HotelViewer.Domain\HotelViewer.Domain.csproj" />
      <ProjectReference Include="..\..\source\HotelViewer.Infrastructure\HotelViewer.Infrastructure.csproj" />
    </ItemGroup>

</Project>